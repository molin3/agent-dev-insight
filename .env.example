# ==========================================
# AgentDevInsight 环境变量配置
# ==========================================

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentdev
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/agentdev

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- LLM（用于自动评估的 LLM-as-Judge）----------
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ---------- SDK 采集 ----------
SDK_INGESTION_MODE=sync
SDK_INGESTION_TIMEOUT=5

# ---------- 评估 ----------
EVAL_MAX_CONCURRENCY=5
EVAL_DEFAULT_MODEL=deepseek-chat

# ---------- 实验 ----------
EXPERIMENT_MAX_CONCURRENCY=10
